---
export interface Props {
  variant: 'home' | 'page' | 'post';
}

const { variant } = Astro.props;
---

<header>
  <nav aria-label="Main navigation">
    <div class="site-identity">
      {variant !== 'home' && <a class="site-title" href="/" transition:name="site-title">Mykal Machon</a>}
    </div>
    <ul>
      <li><a href="/posts">Posts</a></li>
      <li><a href="/about-me">About</a></li>
      <li><button type="button" class="nav-button" data-command-palette-trigger aria-haspopup="dialog">Search</button></li>
    </ul>
  </nav>
</header>
