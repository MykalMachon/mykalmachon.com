---
import Layout from "@components/layout/Layout.astro";
import PostList from "@components/posts/PostList.astro";
import { getCollection } from "astro:content";
export const prerender = true;

const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);
---

<Layout title="Home" description="The home page of Mykal Machon!" type="home">
  <h1>Mykal Machon</h1>
  <p>
    I'm a Senior Software Engineer in Railway's Support Org. This is where I
    write about software, infrastructure, tools, and personal projects, along
    with the occasional note or photo. <a href="/about-me">More about me</a>.
  </p>
  <section>
    <h2>Recent posts</h2>
    <PostList posts={recentPosts} showArchiveLink={true} showDescriptions={true} />
  </section>
</Layout>
