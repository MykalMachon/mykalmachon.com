---
import Layout from "@components/layout/Layout.astro";
import PostList from "@components/posts/PostList.astro";
import { getCollection } from "astro:content";
export const prerender = true;

const allPosts = await getCollection("posts", ({ data }) => data.draft !== true);
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 7);
---

<Layout title="Home" description="The home page of Mykal Machon!" type="home">
  <h1>Mykal Machon</h1>
  <p>Welcome to my personal website! I share posts, notes, photos, and more here. Have fun exploring.</p>

  <section>
    <h2>Latest post</h2>
    <article>
      <h3><a href={`/posts/${recentPosts[0].id}`}>{recentPosts[0].data.title}</a></h3>
      <p>{recentPosts[0].data.description}</p>
    </article>
  </section>

  <section>
    <h2>Other posts</h2>
    <p>I write about programming, web development, tech, and other nerdy stuff.</p>
    <PostList posts={recentPosts.slice(1)} showArchiveLink={true} />
  </section>
</Layout>
