---
import Layout from '@components/layout/Layout.astro';
import ResponsiveImage from '@components/layout/ResponsiveImage.astro';
import PostAttributes from '@components/posts/PostAttributes.astro';
import PostTOC from '@components/posts/PostTOC.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;
export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout title={post.data.title} description={post.data.description || ''} type="post">
  <article>
    <header>
      {post.data.type == 'link' ? <h1><a href={post.data.url}>{post.data.title}</a></h1> : <h1>{post.data.title}</h1>}
      <p>{post.data.description}</p>
      <PostAttributes post={post} />
    </header>

    {post.data.heroImage && <ResponsiveImage src={post.data.heroImage} alt="" sizes={[400, 700, 900]} format="avif" />}

    {headings.length > 0 && (
      <details>
        <summary>Table of contents</summary>
        <PostTOC toc={headings} />
      </details>
    )}

    <Content />

    {post.data.tags && post.data.tags.length > 0 && (
      <footer id="tags" class="post-tags">
        <h2>Tags</h2>
        <ul>
          {post.data.tags.map((tag: string) => <li><a href={`/tags/${tag}`}>#{tag}</a></li>)}
        </ul>
      </footer>
    )}
  </article>
</Layout>
