---
import Layout from "@components/layout/Layout.astro";
import { getTagCount, type TagCount } from "@utils/tags";
import { getCollection } from "astro:content";
export const prerender = true;

const allPosts = await getCollection("posts", (post) => !post.data.draft);
const allTags: TagCount = getTagCount(allPosts);
const sortedTags = Object.entries(allTags).sort((a, b) => b[1] - a[1]);
---

<Layout title="Tags" description="Tags from the posts, links, photos, and notes on this site.">
  <h1>Tags</h1>
  <p>Here's all the tags I've used across my posts.</p>
  <ul>
    {sortedTags.map(([tag, count]) => <li><a href={`/tags/${tag}`}>#{tag}</a> ({count} posts)</li>)}
  </ul>
</Layout>
